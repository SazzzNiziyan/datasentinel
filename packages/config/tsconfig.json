{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Same build shape as packages/contracts (D-13).
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    // Node's Buffer is used to decode the encryption key.
    "types": ["node"]
  },
  "include": ["src"]
}

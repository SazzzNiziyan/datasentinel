{
  // Type-checks prisma.config.ts (run by the Prisma CLI, not built).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.config.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["prisma.config.ts"]
}

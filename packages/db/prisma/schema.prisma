// Identity and workspace tables (docs/03-data-model.md §2, D-26).
// UUIDv7 keys, UTC timestamps (timestamptz), snake_case table names.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  disabled
}

enum IdentityProvider {
  google
  github
}

/// D-02 roles, highest first.
enum Role {
  owner
  admin
  engineer
  analyst
  viewer
}

enum MembershipStatus {
  active
  removed
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase (checked by the database); unique case-insensitively.
  email        String     @unique
  displayName  String     @map("display_name")
  /// Null for accounts that only sign in through Google or GitHub.
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities  ExternalIdentity[]
  sessions    Session[]
  memberships Membership[]

  @@map("users")
}

/// A Google or GitHub sign-in linked to a user (D-01, D-09).
model ExternalIdentity {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  provider  IdentityProvider
  /// The provider's stable user ID, never the email.
  subject   String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("external_identities")
}

/// Only a hash of the session token is stored (docs/05).
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Safe device summary, e.g. "Firefox on Windows"; never raw headers.
  device     String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  /// IANA time zone for schedule display; stored times stay UTC.
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  sources     DataSource[]
  invitations Invitation[]

  @@map("workspaces")
}

model Membership {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        Role
  status      MembershipStatus @default(active)
  invitedAt   DateTime?        @map("invited_at") @db.Timestamptz(3)
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownedSources      DataSource[]
  ownedDatasets     Dataset[]
  invitationsSent   Invitation[]
  uploadsCreated    Upload[]
  connectionTests   ConnectionTest[]
  rulesCreated      QualityRule[]
  schedulesCreated  Schedule[]
  integrationTokens IntegrationToken[]
  incidentsAssigned Incident[]
  incidentEvents    IncidentEvent[]
  ruleRevisions     RuleRevision[]

  @@unique([workspaceId, userId])
  /// Target of composite foreign keys that keep owners in the same workspace.
  @@unique([workspaceId, id])
  @@index([userId])
  @@map("memberships")
}

enum ActorType {
  user
  anonymous
  system
}

/// Append-only record of security and administration events (docs/03 §7,
/// D-33). An UPDATE is refused by a trigger. No foreign keys: the trail
/// outlives deleted users and workspaces; a retention job deletes old rows.
model AuditEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Null for account-level events such as sign-in.
  workspaceId String?   @map("workspace_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id") @db.Uuid
  /// Dotted name, e.g. "member.role_changed".
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  requestId   String?   @map("request_id")
  /// Redacted before/after values; never passwords, tokens, or secrets.
  summary     Json      @default("{}")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

enum SourceType {
  postgres
  csv
  http_api
  pipeline_event
}

/// Lifecycle only; health comes from check results. Delete = archive (D-11).
enum LifecycleStatus {
  active
  paused
  archived
}

/// How sensitive a dataset's contents are; drives masking and AI use later.
enum Sensitivity {
  public
  internal
  confidential
  restricted
}

/// A connection or upload location (docs/03 §3, D-36).
model DataSource {
  id                String          @id @default(uuid(7)) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  name              String
  type              SourceType
  status            LifecycleStatus @default(active)
  ownerMembershipId String?         @map("owner_membership_id") @db.Uuid
  /// Non-secret settings (host, port, database name). Secrets live only in
  /// source_credentials.
  settings          Json            @default("{}")
  lastCheckedAt     DateTime?       @map("last_checked_at") @db.Timestamptz(3)
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner             Membership?        @relation(fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  credentials       SourceCredential[]
  datasets          Dataset[]
  connectionTests   ConnectionTest[]
  uploads           Upload[]
  integrationTokens IntegrationToken[]
  pipelineRuns      PipelineRun[]

  @@unique([workspaceId, name])
  /// Target of composite foreign keys that keep children in the same workspace.
  @@unique([workspaceId, id])
  @@map("data_sources")
}

/// Encrypted connection secret (docs/05). Never serialized to API or web.
/// At most one active (not revoked) credential per source: partial unique
/// index in the migration.
model SourceCredential {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  sourceId    String    @map("source_id") @db.Uuid
  /// AES-GCM ciphertext; the key is outside the database.
  ciphertext  Bytes
  keyVersion  Int       @map("key_version")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  source DataSource @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)

  @@index([sourceId])
  @@map("source_credentials")
}

/// A table, file series, or endpoint checked as one unit.
model Dataset {
  id                String          @id @default(uuid(7)) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  sourceId          String          @map("source_id") @db.Uuid
  /// Stable identity within the source, e.g. "public.orders".
  stableKey         String          @map("stable_key")
  name              String
  description       String?
  ownerMembershipId String?         @map("owner_membership_id") @db.Uuid
  /// Where the data is, validated per source type; never arbitrary SQL.
  locator           Json            @default("{}")
  status            LifecycleStatus @default(active)
  sensitivity       Sensitivity     @default(internal)
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  source           DataSource        @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)
  owner            Membership?       @relation(fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  uploads          Upload[]
  profileSnapshots ProfileSnapshot[]
  schemaSnapshots  SchemaSnapshot[]
  rules            QualityRule[]
  schedules        Schedule[]
  pipelineRuns     PipelineRun[]
  incidents        Incident[]

  @@unique([workspaceId, sourceId, stableKey])
  /// Target of composite foreign keys that keep uploads in the same source.
  @@unique([workspaceId, sourceId, id])
  @@index([workspaceId, status])
  @@map("datasets")
}

/// A one-time link to join a workspace (D-06, D-40). Only the token hash is
/// stored; the link is shown once to the inviting admin.
model Invitation {
  id                    String    @id @default(uuid(7)) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  /// Lowercase; the accepting account must have this email.
  email                 String
  role                  Role
  tokenHash             String    @unique @map("token_hash")
  invitedByMembershipId String    @map("invited_by_membership_id") @db.Uuid
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Membership @relation(fields: [workspaceId, invitedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, email])
  @@map("invitations")
}

enum UploadStatus {
  awaiting_upload
  queued
  parsing
  succeeded
  failed
}

/// One CSV file sent to private storage (D-41). The browser uploads straight
/// to a short-lived signed URL; the worker parses it after completion.
model Upload {
  id                    String       @id @default(uuid(7)) @db.Uuid
  workspaceId           String       @map("workspace_id") @db.Uuid
  sourceId              String       @map("source_id") @db.Uuid
  /// The dataset it feeds (D-10). Null until completion when the user asked
  /// for a new dataset, whose name waits in new_dataset_name.
  datasetId             String?      @map("dataset_id") @db.Uuid
  newDatasetName        String?      @map("new_dataset_name")
  /// Random, never derived from user input (D-38).
  objectKey             String       @unique @map("object_key")
  /// Display only, cleaned of paths and control characters; never trusted.
  filename              String
  sizeBytes             Int          @map("size_bytes")
  /// Lowercase hex SHA-256 the browser declared; storage and the worker check it.
  checksumSha256        String       @map("checksum_sha256")
  status                UploadStatus @default(awaiting_upload)
  /// Safe failure (ConnectorFailure JSON), never a raw error.
  error                 Json?
  /// Set when parsing succeeds: data rows (header excluded) and columns.
  rowCount              Int?         @map("row_count")
  columnCount           Int?         @map("column_count")
  createdByMembershipId String       @map("created_by_membership_id") @db.Uuid
  uploadUrlExpiresAt    DateTime     @map("upload_url_expires_at") @db.Timestamptz(3)
  completedAt           DateTime?    @map("completed_at") @db.Timestamptz(3)
  /// Raw file deletion date (D-08: 30 days).
  retainUntil           DateTime     @map("retain_until") @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  source           DataSource        @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)
  /// Cascade: datasets and memberships are archived or removed by status, so
  /// rows are deleted only with their workspace, in any order.
  dataset          Dataset?          @relation(fields: [workspaceId, sourceId, datasetId], references: [workspaceId, sourceId, id], onDelete: Cascade, onUpdate: NoAction)
  profileSnapshots ProfileSnapshot[]
  createdBy        Membership        @relation(fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, sourceId, createdAt])
  @@index([retainUntil])
  @@map("uploads")
}

enum ProfileStatus {
  succeeded
  failed
}

/// One profiling attempt of a dataset (docs/03, D-43). Append-only: a
/// trigger refuses UPDATE. A failed attempt keeps its safe error instead of
/// looking like an empty dataset (FR-04).
model ProfileSnapshot {
  id             String        @id @default(uuid(7)) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  sourceId       String        @map("source_id") @db.Uuid
  datasetId      String        @map("dataset_id") @db.Uuid
  /// The CSV upload that was profiled; null for other source types.
  uploadId       String?       @map("upload_id") @db.Uuid
  status         ProfileStatus
  observedAt     DateTime      @map("observed_at") @db.Timestamptz(3)
  /// Null when the attempt failed.
  rowCount       BigInt?       @map("row_count")
  /// "exact" or "approximate" (a planner estimate).
  rowCountMethod String?       @map("row_count_method")
  /// When the data last changed; for CSV, the upload time (D-10).
  lastUpdatedAt  DateTime?     @map("last_updated_at") @db.Timestamptz(3)
  /// Per-column metrics such as null counts; never sample values.
  metrics        Json          @default("{}")
  /// Safe failure (ConnectorFailure JSON) when status is failed.
  error          Json?
  durationMs     Int           @map("duration_ms")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  dataset Dataset         @relation(fields: [workspaceId, sourceId, datasetId], references: [workspaceId, sourceId, id], onDelete: Cascade)
  upload  Upload?         @relation(fields: [uploadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schema  SchemaSnapshot?

  @@index([workspaceId, datasetId, observedAt])
  @@index([uploadId])
  @@map("profile_snapshots")
}

/// The columns a successful profile saw (docs/03, D-43). Append-only. The
/// hash covers names, types, and order, so equal hashes mean no drift.
model SchemaSnapshot {
  id                String   @id @default(uuid(7)) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  sourceId          String   @map("source_id") @db.Uuid
  datasetId         String   @map("dataset_id") @db.Uuid
  profileSnapshotId String   @unique @map("profile_snapshot_id") @db.Uuid
  observedAt        DateTime @map("observed_at") @db.Timestamptz(3)
  /// Lowercase hex SHA-256 of the ordered (name, type) list.
  schemaHash        String   @map("schema_hash")
  /// ObservedColumn[]: name, type, nullable, ordinal. No sample values.
  columns           Json
  rowCount          BigInt   @map("row_count")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dataset Dataset         @relation(fields: [workspaceId, sourceId, datasetId], references: [workspaceId, sourceId, id], onDelete: Cascade)
  profile ProfileSnapshot @relation(fields: [profileSnapshotId], references: [id], onDelete: Cascade)

  @@index([workspaceId, datasetId, observedAt])
  @@map("schema_snapshots")
}

enum ConnectionTestStatus {
  queued
  running
  succeeded
  failed
}

/// One "test connection" request for a source (D-49), run by the worker.
model ConnectionTest {
  id                      String               @id @default(uuid(7)) @db.Uuid
  workspaceId             String               @map("workspace_id") @db.Uuid
  sourceId                String               @map("source_id") @db.Uuid
  status                  ConnectionTestStatus @default(queued)
  /// Major.minor only, e.g. "16.4".
  serverVersion           String?              @map("server_version")
  latencyMs               Int?                 @map("latency_ms")
  /// Safe failure (ConnectorFailure JSON), never driver text.
  error                   Json?
  requestedByMembershipId String               @map("requested_by_membership_id") @db.Uuid
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt              DateTime?            @map("finished_at") @db.Timestamptz(3)

  source      DataSource @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)
  requestedBy Membership @relation(fields: [workspaceId, requestedByMembershipId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, sourceId, createdAt])
  @@map("connection_tests")
}

/// Q-02, D-58: only critical opens an incident.
enum RuleSeverity {
  critical
  warning
  info
}

/// FR-05, D-59. The definition lives in revisions; `currentVersion` points
/// at the one new checks use.
model QualityRule {
  id                    String       @id @default(uuid(7)) @db.Uuid
  workspaceId           String       @map("workspace_id") @db.Uuid
  sourceId              String       @map("source_id") @db.Uuid
  datasetId             String       @map("dataset_id") @db.Uuid
  name                  String
  /// RuleDefinition["type"], copied from the current revision for filtering.
  type                  String
  severity              RuleSeverity
  enabled               Boolean      @default(true)
  currentVersion        Int          @map("current_version")
  createdByMembershipId String?      @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  dataset   Dataset        @relation(fields: [workspaceId, sourceId, datasetId], references: [workspaceId, sourceId, id], onDelete: Cascade)
  createdBy Membership?    @relation(fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  revisions RuleRevision[]
  checkRuns CheckRun[]
  schedules Schedule[]
  incidents Incident[]

  @@unique([workspaceId, id])
  @@index([workspaceId, datasetId])
  @@map("quality_rules")
}

/// Immutable (append-only trigger): a past check points at the exact
/// definition it ran.
model RuleRevision {
  id                    String       @id @default(uuid(7)) @db.Uuid
  workspaceId           String       @map("workspace_id") @db.Uuid
  ruleId                String       @map("rule_id") @db.Uuid
  version               Int
  /// Validated RuleDefinition JSON (packages/contracts rules.ts).
  definition            Json
  severity              RuleSeverity
  createdByMembershipId String?      @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  rule      QualityRule @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Cascade)
  createdBy Membership? @relation(fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  checkRuns CheckRun[]

  @@unique([ruleId, version])
  @@unique([workspaceId, id])
  @@map("rule_revisions")
}

enum CheckTrigger {
  manual
  schedule
  event
}

/// Q-04, D-58: insufficient_data is its own state, never a pass.
enum CheckRunStatus {
  queued
  running
  passed
  failed
  insufficient_data
  error
}

/// FR-06. Unchangeable once terminal (trigger); the idempotency key keeps
/// a repeated request from creating a second run.
model CheckRun {
  id             String         @id @default(uuid(7)) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  ruleId         String         @map("rule_id") @db.Uuid
  ruleRevisionId String         @map("rule_revision_id") @db.Uuid
  trigger        CheckTrigger
  status         CheckRunStatus @default(queued)
  /// The condition checked, e.g. { maxAgeMinutes }.
  expected       Json?
  /// Measured values only; never row samples.
  actual         Json?
  /// Safe failure (ConnectorFailure JSON) when status is error.
  error          Json?
  idempotencyKey String         @map("idempotency_key")
  /// The schedule occurrence that started it; null for manual runs (D-71).
  occurrenceId   String?        @map("occurrence_id") @db.Uuid
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?      @map("ended_at") @db.Timestamptz(3)
  durationMs     Int?           @map("duration_ms")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  rule       QualityRule         @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Cascade)
  revision   RuleRevision        @relation(fields: [workspaceId, ruleRevisionId], references: [workspaceId, id], onDelete: Cascade)
  occurrence ScheduleOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, ruleId, createdAt])
  @@index([occurrenceId])
  @@map("check_runs")
}

enum ScheduleTarget {
  /// Profile the dataset (databases), then run its enabled rules.
  dataset
  /// Run one rule.
  rule
}

/// When checks run on their own (D-69). The definition is validated JSON
/// (packages/contracts schedules.ts): an interval of 15 minutes to a week,
/// or set times of day in an IANA time zone. An occurrence still running
/// when the next one is due makes the next one skip.
model Schedule {
  id                    String         @id @default(uuid(7)) @db.Uuid
  workspaceId           String         @map("workspace_id") @db.Uuid
  sourceId              String         @map("source_id") @db.Uuid
  datasetId             String         @map("dataset_id") @db.Uuid
  /// Set exactly when the target is one rule (check constraint).
  ruleId                String?        @map("rule_id") @db.Uuid
  targetType            ScheduleTarget @map("target_type")
  definition            Json
  enabled               Boolean        @default(true)
  /// Intervals step from here, so they do not drift.
  anchorAt              DateTime       @map("anchor_at") @db.Timestamptz(3)
  /// Null while paused.
  nextRunAt             DateTime?      @map("next_run_at") @db.Timestamptz(3)
  lastRunAt             DateTime?      @map("last_run_at") @db.Timestamptz(3)
  createdByMembershipId String?        @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  dataset   Dataset      @relation(fields: [workspaceId, sourceId, datasetId], references: [workspaceId, sourceId, id], onDelete: Cascade)
  rule      QualityRule? @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Cascade)
  createdBy Membership?  @relation(fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  occurrences ScheduleOccurrence[]

  @@index([enabled, nextRunAt])
  @@index([workspaceId, datasetId])
  @@map("schedules")
}

enum OccurrenceStatus {
  /// Claimed by the scheduler; jobs not queued yet.
  pending
  /// Its jobs are queued.
  enqueued
  /// Not run, e.g. the previous occurrence was still running.
  skipped
}

/// One due time of a schedule (D-70). Unique per schedule and time: two
/// scheduler ticks, or two workers, cannot both claim it.
model ScheduleOccurrence {
  id           String           @id @default(uuid(7)) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  scheduleId   String           @map("schedule_id") @db.Uuid
  scheduledFor DateTime         @map("scheduled_for") @db.Timestamptz(3)
  status       OccurrenceStatus @default(pending)
  /// Due times passed over while the scheduler was not running.
  missedBefore Int              @default(0) @map("missed_before")
  skipReason   String?          @map("skip_reason")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  schedule  Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  checkRuns CheckRun[]

  @@unique([scheduleId, scheduledFor])
  @@index([workspaceId, createdAt])
  /// The scheduler's stranded-occurrence retry (D-70).
  @@index([status, createdAt])
  @@map("schedule_occurrences")
}

/// A source-scoped credential for pipeline-run events (D-73). The token
/// shown once is `dsp_{id}_{secret}`; only SHA-256 of the secret is kept.
model IntegrationToken {
  id                    String    @id @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  sourceId              String    @map("source_id") @db.Uuid
  name                  String
  secretHash            Bytes     @map("secret_hash")
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)

  source    DataSource  @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)
  createdBy Membership? @relation(fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, sourceId])
  @@map("integration_tokens")
}

/// FR-07 run states.
enum PipelineRunStatus {
  queued
  running
  succeeded
  failed
  timed_out
  cancelled
  unknown
}

/// A run reported by an external job (D-73). `externalRunId` is unique per
/// source, which makes event ingestion idempotent.
model PipelineRun {
  id               String            @id @default(uuid(7)) @db.Uuid
  workspaceId      String            @map("workspace_id") @db.Uuid
  sourceId         String            @map("source_id") @db.Uuid
  datasetId        String?           @map("dataset_id") @db.Uuid
  externalRunId    String            @map("external_run_id")
  name             String
  status           PipelineRunStatus
  /// schedule, manual, upstream, or unknown.
  trigger          String
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(3)
  endedAt          DateTime?         @map("ended_at") @db.Timestamptz(3)
  lastEventAt      DateTime          @map("last_event_at") @db.Timestamptz(3)
  correlationId    String?           @map("correlation_id")
  /// Redacted, at most 2,000 characters.
  summary          String?
  createdByTokenId String?           @map("created_by_token_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  source  DataSource @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)
  dataset Dataset?   @relation(fields: [workspaceId, sourceId, datasetId], references: [workspaceId, sourceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sourceId, externalRunId])
  @@index([workspaceId, createdAt])
  @@map("pipeline_runs")
}

/// FR-09 incident states (D-79). Transitions are validated in the API.
enum IncidentStatus {
  open
  acknowledged
  investigating
  resolved
  reopened
}

/// One data problem (D-80): repeated failures of a rule group into one
/// incident through the dedupe key. At most one unresolved incident per
/// (workspace, dedupe key): a partial unique index in the migration.
model Incident {
  id                   String         @id @default(uuid(7)) @db.Uuid
  workspaceId          String         @map("workspace_id") @db.Uuid
  sourceId             String         @map("source_id") @db.Uuid
  datasetId            String         @map("dataset_id") @db.Uuid
  ruleId               String         @map("rule_id") @db.Uuid
  /// `rule:{ruleId}` (D-79).
  dedupeKey            String         @map("dedupe_key")
  title                String
  severity             RuleSeverity
  status               IncidentStatus @default(open)
  assignedMembershipId String?        @map("assigned_membership_id") @db.Uuid
  /// Failed checks attached as evidence.
  failureCount         Int            @default(0) @map("failure_count")
  lastFailureAt        DateTime       @map("last_failure_at") @db.Timestamptz(3)
  openedAt             DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt           DateTime?      @map("resolved_at") @db.Timestamptz(3)
  resolutionNote       String?        @map("resolution_note")
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  dataset  Dataset         @relation(fields: [workspaceId, sourceId, datasetId], references: [workspaceId, sourceId, id], onDelete: Cascade)
  rule     QualityRule     @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Cascade)
  assignee Membership?     @relation(fields: [workspaceId, assignedMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  events   IncidentEvent[]
  evidence Evidence[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, openedAt])
  @@index([workspaceId, dedupeKey, openedAt])
  @@map("incidents")
}

/// Append-only history of an incident: opened, reopened, status and
/// assignment changes (D-80).
model IncidentEvent {
  id                String          @id @default(uuid(7)) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  incidentId        String          @map("incident_id") @db.Uuid
  /// `system` or `user`.
  actorType         String          @map("actor_type")
  actorMembershipId String?         @map("actor_membership_id") @db.Uuid
  type              String
  fromStatus        IncidentStatus? @map("from_status")
  toStatus          IncidentStatus? @map("to_status")
  /// Safe details only, never secrets.
  details           Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident    @relation(fields: [workspaceId, incidentId], references: [workspaceId, id], onDelete: Cascade)
  actor    Membership? @relation(fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, incidentId, createdAt])
  @@map("incident_events")
}

/// A reference to a record that supports an incident, with a small safe
/// summary (D-80). One row per (incident, kind, record): attaching the same
/// check again changes nothing.
model Evidence {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  /// `check_run` for now; profile, schema, and pipeline run follow.
  kind        String
  referenceId String   @map("reference_id") @db.Uuid
  observedAt  DateTime @map("observed_at") @db.Timestamptz(3)
  /// Measured values only, never row samples.
  summary     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [workspaceId, incidentId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([incidentId, kind, referenceId])
  @@index([workspaceId, incidentId])
  @@map("evidence")
}

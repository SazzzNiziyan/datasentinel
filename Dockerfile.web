# The web app as static files behind nginx: docker build -f Dockerfile.web .
# TLS terminates at the load balancer or reverse proxy in front of it.
FROM node:26-alpine AS build
RUN npm install -g pnpm@12.14.0
WORKDIR /repo
COPY . .
# Generating the Prisma client never connects; this placeholder is build-only.
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
RUN pnpm install --frozen-lockfile && pnpm --filter ./apps/web... build

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080

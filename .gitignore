# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.vite/
*.tsbuildinfo
coverage/

# Secrets and local environment
# Only .env.example (names + safe placeholders) is committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local service data (container volumes for PostgreSQL, Redis, MinIO)
.data/
.docker-data/
*.sqlite
*.sqlite3
*.db
dump.rdb

# Uploads and sample files that may hold real data
uploads/
tmp/
*.csv
!**/fixtures/**/*.csv
!**/seed/**/*.csv

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Test artifacts
playwright-report/
test-results/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local-only settings
.claude/settings.local.json

# Playwright MCP plugin output (screenshots, page snapshots, console logs)
.playwright-mcp/

{
  // Shared compiler settings for every workspace package (D-13).
  // Packages extend this file and add only what their runtime needs.
  // Must stay valid for TypeScript 6 and 7: no baseUrl, no node10 resolution.
  "compilerOptions": {
    // Type safety: strict plus curated extras.
    // strict is the TS 6+ default; it is set explicitly because
    // `tsc --showConfig` does not print it.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    // Language and modules: Node 26 runs ES2025 natively; packages are ESM.
    "target": "es2025",
    "lib": ["es2025"],
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // TS 6+ loads no @types packages unless listed; each package sets its own.
    "types": [],

    "skipLibCheck": true
  }
}

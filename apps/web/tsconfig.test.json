{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Type-checks component tests (and the src they import) in a DOM context.
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // Tests run on Node 26, so ES2025 is available here; the browser limit
    // (es2023) is still enforced on src by tsconfig.app.json.
    "lib": ["es2025", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"]
  },
  "include": ["test", "src"]
}

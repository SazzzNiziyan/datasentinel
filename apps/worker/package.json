{
  "name": "@datasentinel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b ../../packages/contracts ../../packages/config ../../packages/connectors ../../packages/db && nest build",
    "dev": "nest start --watch --exec \"node --env-file=env/development.env --env-file-if-exists=../../.env --conditions=@datasentinel/source\"",
    "start": "node --env-file=env/production.env --env-file-if-exists=../../.env dist/main.js",
    "sample-job": "node --env-file-if-exists=../../.env dist/dev/enqueue-ping.js",
    "typecheck": "tsc -b",
    "test": "tsc -b ../../packages/contracts ../../packages/config ../../packages/connectors ../../packages/db && tsc -p tsconfig.test.json && node --env-file-if-exists=../../.env --test \"dist/test-build/test/**/*.test.js\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@datasentinel/config": "workspace:*",
    "@datasentinel/connectors": "workspace:*",
    "@datasentinel/contracts": "workspace:*",
    "@datasentinel/db": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "bullmq": "^6.3.15",
    "csv-parse": "^7.0.3",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/nodemailer": "^8.0.2"
  }
}

# DataSentinel local development environment.
#
# Copy to .env and fill in the empty values. Never commit .env.
# Every value here is a local-only placeholder; use different credentials,
# keys, buckets, and databases for development, staging, and production.
#
# Empty secrets are intentional: configuration parsing must refuse to start
# until they are set. Generate a 32-byte random value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

# NODE_ENV is not set here: each start script sets it (development, test,
# production). In a .env file Vite would read it too and ship development
# React in production builds.
LOG_LEVEL=info

# --- API -------------------------------------------------------------------
API_PORT=3000
# Browser origin allowed by CORS/CSRF checks.
WEB_ORIGIN=http://localhost:5173

# --- Web (Vite exposes only VITE_* variables, and they are public) ----------
# Never put a secret in a VITE_* variable: it is bundled into the browser.
# The web app reads this file via envDir in apps/web/vite.config.ts (added
# with the Vite scaffold); Vite otherwise looks only in apps/web.
VITE_API_BASE_URL=http://localhost:3000

# --- Application database (local container) ---------------------------------
DATABASE_URL=postgresql://datasentinel:datasentinel-local@localhost:5432/datasentinel?schema=public

# Optional: password for every account created by `pnpm --filter
# @datasentinel/api seed` (fake local accounts only). When unset, the seed
# generates one and prints it once.
# SEED_PASSWORD=

# --- Redis / BullMQ (local container) ---------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (local MinIO container; private bucket) -----------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=datasentinel-uploads-dev
S3_ACCESS_KEY_ID=datasentinel-local
S3_SECRET_ACCESS_KEY=datasentinel-local-secret

# --- Sessions and secret encryption ------------------------------------------
# Signs session cookies. Generate (see top of file).
SESSION_SECRET=
# Authenticated encryption key for stored source/integration secrets.
# Kept outside the database; the version is stored with each ciphertext
# so keys can be rotated. Generate (see top of file).
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY_VERSION=1
# Rotation (D-46): set a new key and a higher version above, move the old
# one here as "version:key" (comma-separate several), then run
#   pnpm --filter @datasentinel/api credentials:rewrap
# When it reports 0 that could not be opened, remove the old key here.
# SECRETS_ENCRYPTION_PREVIOUS_KEYS=1:<old base64 key>

# --- Sign-in providers (D-01, D-09) -----------------------------------------
# Create development-only OAuth apps:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
# Callback URLs: ${OAUTH_CALLBACK_BASE_URL}/auth/google/callback and /auth/github/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (provider is open: D-06) -----------------------------------------
# Variable names are added when D-06 is decided.

# --- AI investigation (provider, model, region are open: D-07) --------------
# Variable names are added when D-07 is decided. Model credentials belong in
# the secret manager in production, never in a VITE_* variable.

# --- Optional alert destinations (D-96) ---------------------------------------
# Off by default. GitHub issues use a fine-grained token limited to one
# repository with only "Issues: write".
FEATURE_DESTINATION_GITHUB=false
FEATURE_DESTINATION_N8N=false

# --- AI investigation (D-99) --------------------------------------------------
# Off unless FEATURE_AI is true AND the provider, region, and retention below
# are all filled in: workspace admins see these before they opt in. No
# provider is bundled except Gemini (set AI_API_KEY); model credentials belong
# in the secret manager.
FEATURE_AI=false
AI_PROVIDER_NAME=
AI_PROVIDER_REGION=
AI_RETENTION_NOTE=
# Most tokens (input plus output) one workspace may use with the AI provider
# per UTC day. Calls past it fail with budget_exceeded.
AI_DAILY_TOKEN_BUDGET=200000

# Google AI Studio key: turns on the bundled Gemini provider. AI_MODEL is optional
# (default gemini-2.5-flash).
AI_API_KEY=
AI_MODEL=

# --- Email (D-130) ------------------------------------------------------------
# Any SMTP server: smtps://user:password@host:465 (write @ in a user name as
# %40). Without both values, email deliveries fail visibly (email_not_configured).
SMTP_URL=
EMAIL_FROM=

# --- Hosting on small plans (D-129) -------------------------------------------
# A direct (unpooled) database address for migrations, when DATABASE_URL is a
# pooled one (Neon). Leave empty otherwise.
DIRECT_DATABASE_URL=
# Connections per database client (default 10); lower it on small database plans.
DB_POOL_MAX=
# true only when nginx on the same machine forwards requests to the API.
TRUST_PROXY=false

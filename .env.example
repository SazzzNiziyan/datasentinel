# DataSentinel local development environment.
#
# Copy to .env and fill in the empty values. Never commit .env.
# Every value here is a local-only placeholder; use different credentials,
# keys, buckets, and databases for development, staging, and production.
#
# Empty secrets are intentional: configuration parsing must refuse to start
# until they are set. Generate a 32-byte random value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
LOG_LEVEL=info

# --- API -------------------------------------------------------------------
API_PORT=3000
# Browser origin allowed by CORS/CSRF checks.
WEB_ORIGIN=http://localhost:5173

# --- Web (Vite exposes only VITE_* variables, and they are public) ----------
# Never put a secret in a VITE_* variable: it is bundled into the browser.
# The web app reads this file via envDir in apps/web/vite.config.ts (added
# with the Vite scaffold); Vite otherwise looks only in apps/web.
VITE_API_BASE_URL=http://localhost:3000

# --- Application database (local container) ---------------------------------
DATABASE_URL=postgresql://datasentinel:datasentinel-local@localhost:5432/datasentinel?schema=public

# --- Redis / BullMQ (local container) ---------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (local MinIO container; private bucket) -----------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=datasentinel-uploads-dev
S3_ACCESS_KEY_ID=datasentinel-local
S3_SECRET_ACCESS_KEY=datasentinel-local-secret

# --- Sessions and secret encryption ------------------------------------------
# Signs session cookies. Generate (see top of file).
SESSION_SECRET=
# Authenticated encryption key for stored source/integration secrets.
# Kept outside the database; the version is stored with each ciphertext
# so keys can be rotated. Generate (see top of file).
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY_VERSION=1

# --- Sign-in providers (D-01, D-09) -----------------------------------------
# Create development-only OAuth apps:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
# Callback URLs: ${OAUTH_CALLBACK_BASE_URL}/auth/google/callback and /auth/github/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (provider is open: D-06) -----------------------------------------
# Variable names are added when D-06 is decided.

# --- AI investigation (provider, model, region are open: D-07) --------------
# Variable names are added when D-07 is decided. Model credentials belong in
# the secret manager in production, never in a VITE_* variable.
